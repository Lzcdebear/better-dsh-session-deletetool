{
  "name": "dsh-session-delete",
  "version": "0.2.1",
  "type": "module",
  "description": "Delete a conversation from the DSH sidebar instead of only archiving it, choosing which of its subagent and forked conversations go with it. / 在会话菜单里真正删除对话，并可勾选连带删除哪些子智能体会话与派生对话。",
  "license": "MIT",
  "author": "Lzcdebear",
  "icon": "./icon.svg",
  "meta": {
    "title": "会话删除 / Session Delete",
    "description": "会话「⋯」菜单里多一项「删除会话」：先列出它的子智能体会话与派生对话，可折叠、可逐项勾选，确认后删掉日志、工程记录与投影缓存，不只是归档隐藏。"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "conversation",
    "delete",
    "archive"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lzcdebear/dsh-delete-session.git"
  },
  "homepage": "https://github.com/Lzcdebear/dsh-delete-session#readme",
  "bugs": {
    "url": "https://github.com/Lzcdebear/dsh-delete-session/issues"
  },
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/host.test.mjs"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
